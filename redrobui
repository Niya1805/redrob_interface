<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>RedRob AI — Student Dashboard (Hi-Fi Mockup)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#14110F;
    --ink-soft:rgba(20,17,15,.62);
    --ink-faint:rgba(20,17,15,.38);
    --paper:#FAF7F3;
    --surface:#FFFFFF;
    --mist:#F0EBE3;
    --line:#E5DED2;
    --rob-red:#C6303E;
    --rob-red-deep:#8F1F2B;
    --amber:#F2A54A;
    --amber-soft:#FCE6C9;
    --success:#2E9E6D;
    --success-soft:#DCF1E7;
    --radius-lg:22px;
    --radius-md:16px;
    --radius-sm:10px;
    --shadow-card:0 1px 2px rgba(20,17,15,.04), 0 10px 24px -12px rgba(20,17,15,.14);
    --shadow-pop:0 4px 8px rgba(20,17,15,.06), 0 20px 40px -16px rgba(20,17,15,.22);
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;font-size:14px;line-height:1.5;}
  .display{font-family:'Space Grotesk',sans-serif;}
  .mono{font-family:'IBM Plex Mono',monospace;letter-spacing:.01em;}

  .app{display:grid;grid-template-columns:264px 1fr;min-height:100vh;}

  /* ===== SIDEBAR ===== */
  .sidebar{background:var(--ink);color:#F3EFE9;padding:22px 16px;display:flex;flex-direction:column;gap:6px;position:sticky;top:0;height:100vh;}
  .brand{display:flex;align-items:center;gap:10px;padding:4px 8px 22px;}
  .brand .mark{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--rob-red),var(--amber));display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk';font-weight:700;font-size:15px;color:#fff;}
  .brand .name{font-family:'Space Grotesk';font-weight:700;font-size:16.5px;}
  .brand .tag{font-size:10px;color:rgba(243,239,233,.45);font-weight:500;margin-top:1px;}

  .new-chat{display:flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--rob-red),var(--rob-red-deep));color:#fff;border:none;border-radius:var(--radius-sm);padding:11px 14px;font-family:'Inter';font-weight:600;font-size:13.5px;cursor:pointer;margin-bottom:14px;box-shadow:0 6px 16px -6px rgba(198,48,62,.55);}

  .nav-group{margin-top:10px;}
  .nav-label{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:rgba(243,239,233,.35);font-weight:600;padding:6px 10px 6px;}
  .nav-item{display:flex;align-items:center;gap:11px;padding:9px 10px;border-radius:var(--radius-sm);color:rgba(243,239,233,.78);text-decoration:none;font-weight:500;font-size:13.5px;cursor:pointer;}
  .nav-item .ic{width:18px;height:18px;flex:none;opacity:.85;}
  .nav-item:hover{background:rgba(243,239,233,.06);color:#fff;}
  .nav-item.active{background:rgba(242,165,74,.14);color:#F2A54A;font-weight:600;}
  .nav-item .badge{margin-left:auto;background:var(--amber);color:var(--ink);font-size:10px;font-weight:700;border-radius:20px;padding:1px 7px;}

  .history-list{margin-top:2px;display:flex;flex-direction:column;gap:1px;}
  .history-item{padding:7px 10px;border-radius:8px;color:rgba(243,239,233,.5);font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;}
  .history-item:hover{background:rgba(243,239,233,.06);color:rgba(243,239,233,.85);}

  .sidebar-foot{margin-top:auto;padding-top:14px;border-top:1px solid rgba(243,239,233,.1);}
  .profile-mini{display:flex;align-items:center;gap:10px;padding:8px 8px;border-radius:var(--radius-sm);cursor:pointer;}
  .profile-mini:hover{background:rgba(243,239,233,.06);}
  .avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#F2A54A,#C6303E);display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk';font-weight:700;color:#fff;font-size:13px;flex:none;}
  .profile-mini .who{display:flex;flex-direction:column;}
  .profile-mini .who b{font-size:12.5px;color:#fff;font-weight:600;}
  .profile-mini .who span{font-size:11px;color:rgba(243,239,233,.45);}

  /* ===== MAIN ===== */
  .main{padding:26px 34px 60px;max-width:1180px;}

  .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;}
  .greeting h1{font-size:23px;margin:0 0 3px;font-weight:700;}
  .greeting p{margin:0;color:var(--ink-soft);font-size:13.5px;}
  .streakpill{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--line);padding:8px 14px 8px 10px;border-radius:30px;box-shadow:var(--shadow-card);}
  .streakpill .flame{font-size:17px;}
  .streakpill b{font-family:'IBM Plex Mono';font-size:14px;}
  .streakpill span{color:var(--ink-soft);font-size:12px;}

  /* stat row */
  .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
  .stat-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-md);padding:16px 17px;box-shadow:var(--shadow-card);position:relative;overflow:hidden;}
  .stat-card .label{font-size:11.5px;color:var(--ink-soft);font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px;}
  .stat-card .value{font-family:'Space Grotesk';font-size:24px;font-weight:700;}
  .stat-card .sub{font-size:11.5px;color:var(--ink-faint);margin-top:2px;}
  .stat-card.accent{background:linear-gradient(150deg,var(--rob-red) 0%,var(--rob-red-deep) 100%);color:#fff;border:none;}
  .stat-card.accent .label{color:rgba(255,255,255,.75);}
  .stat-card.accent .sub{color:rgba(255,255,255,.6);}
  .ring{width:34px;height:34px;position:absolute;top:14px;right:14px;}

  /* chat block */
  .chat-shell{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);box-shadow:var(--shadow-pop);padding:26px 28px 20px;margin-bottom:24px;}
  .chat-shell .kicker{display:flex;align-items:center;gap:8px;margin-bottom:14px;}
  .kicker .dot{width:7px;height:7px;border-radius:50%;background:var(--success);box-shadow:0 0 0 3px var(--success-soft);}
  .kicker span{font-size:12px;color:var(--ink-soft);font-weight:600;}
  .chat-empty{text-align:center;padding:20px 10px 26px;}
  .chat-empty h2{font-size:19px;margin:0 0 4px;font-family:'Space Grotesk';}
  .chat-empty p{margin:0;color:var(--ink-soft);font-size:13px;}

  .suggest-row{display:flex;gap:9px;flex-wrap:wrap;justify-content:center;margin:16px 0 20px;}
  .chip{background:var(--mist);border:1px solid var(--line);padding:8px 14px;border-radius:20px;font-size:12.5px;font-weight:500;color:var(--ink);cursor:pointer;}
  .chip:hover{background:var(--amber-soft);border-color:var(--amber);}

  .input-bar{display:flex;align-items:center;gap:10px;background:var(--mist);border:1px solid var(--line);border-radius:16px;padding:10px 10px 10px 18px;}
  .input-bar input{border:none;background:transparent;outline:none;flex:1;font-family:'Inter';font-size:14px;color:var(--ink);}
  .input-bar input::placeholder{color:var(--ink-faint);}
  .icon-btn{width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:var(--surface);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none;font-size:14px;}
  .send-btn{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--rob-red),var(--rob-red-deep));border:none;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none;}
  .selectors{display:flex;gap:8px;margin-top:12px;}
  .selector{font-size:11.5px;color:var(--ink-soft);background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:6px 10px;font-weight:600;display:flex;align-items:center;gap:5px;}

  /* two column: app store + internships */
  .grid-2{display:grid;grid-template-columns:1.35fr 1fr;gap:18px;}
  .panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);padding:20px 20px 8px;box-shadow:var(--shadow-card);}
  .panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
  .panel-head h3{font-family:'Space Grotesk';font-size:15.5px;margin:0;}
  .panel-head a{font-size:12px;color:var(--rob-red);font-weight:600;text-decoration:none;}

  .tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding-bottom:12px;}
  .tool-card{border:1px solid var(--line);border-radius:var(--radius-sm);padding:13px 12px;cursor:pointer;}
  .tool-card:hover{border-color:var(--amber);background:var(--amber-soft);}
  .tool-card .emo{font-size:18px;margin-bottom:8px;display:block;}
  .tool-card b{font-size:12.5px;display:block;margin-bottom:2px;}
  .tool-card span{font-size:11px;color:var(--ink-soft);}

  .intern-list{display:flex;flex-direction:column;gap:10px;padding-bottom:14px;}
  .intern-item{display:flex;gap:11px;align-items:center;border:1px solid var(--line);border-radius:var(--radius-sm);padding:10px 12px;}
  .co-logo{width:36px;height:36px;border-radius:9px;background:var(--mist);display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk';font-weight:700;font-size:13px;color:var(--ink-soft);flex:none;}
  .intern-item .info b{font-size:12.5px;display:block;}
  .intern-item .info span{font-size:11px;color:var(--ink-soft);}
  .match{margin-left:auto;font-family:'IBM Plex Mono';font-size:11px;color:var(--success);background:var(--success-soft);padding:3px 8px;border-radius:20px;font-weight:600;}
</style>
</head>
<body>
<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">
      <div class="mark">R</div>
      <div>
        <div class="name">RedRob</div>
        <div class="tag">Student Mode</div>
      </div>
    </div>

    <button class="new-chat">＋ New chat</button>

    <div class="nav-group">
      <div class="nav-item active">💬 Chat history</div>
      <div class="history-list">
        <div class="history-item">Resume review — SDE intern</div>
        <div class="history-item">Explain binary search trees</div>
        <div class="history-item">Cover letter for Razorpay</div>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-label">Workspace</div>
      <div class="nav-item">🧩 AI App Store <span class="badge">New</span></div>
      <div class="nav-item">👥 Contacts</div>
      <div class="nav-item">📁 Projects</div>
      <div class="nav-item">📝 Notepad</div>
      <div class="nav-item">🗣️ Discussions</div>
    </div>

    <div class="sidebar-foot">
      <div class="profile-mini">
        <div class="avatar">AS</div>
        <div class="who">
          <b>Aisha Sheikh</b>
          <span>B.Tech CSE · Final yr</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <div class="topbar">
      <div class="greeting">
        <h1>Good evening, Aisha 👋</h1>
        <p>You're 3 tasks away from finishing your placement prep sprint.</p>
      </div>
      <div class="streakpill">
        <span class="flame">🔥</span>
        <b>18</b>
        <span>day streak</span>
      </div>
    </div>

    <div class="stat-row">
      <div class="stat-card accent">
        <div class="label">Placement progress</div>
        <div class="value">62%</div>
        <div class="sub">Resume ✓ · Aptitude ✓ · Mock interview pending</div>
      </div>
      <div class="stat-card">
        <div class="label">Learning streak</div>
        <div class="value">18 days</div>
        <div class="sub">Best: 31 days</div>
      </div>
      <div class="stat-card">
        <div class="label">Upcoming deadline</div>
        <div class="value">2 days</div>
        <div class="sub">Deloitte internship application</div>
      </div>
      <div class="stat-card">
        <div class="label">Saved internships</div>
        <div class="value">7</div>
        <div class="sub">3 closing this week</div>
      </div>
    </div>

    <div class="chat-shell">
      <div class="kicker"><span class="dot"></span><span>RedRob AI · GPT‑class model · Study mode</span></div>
      <div class="chat-empty">
        <h2 class="display">What are we working on today?</h2>
        <p>Ask anything — homework, code, interview prep, or company research.</p>
      </div>
      <div class="suggest-row">
        <div class="chip">📄 Review my resume</div>
        <div class="chip">💻 Debug my Python code</div>
        <div class="chip">🏢 Research a company before I apply</div>
        <div class="chip">🎯 Mock interview — SDE role</div>
      </div>
      <div class="input-bar">
        <div class="icon-btn">📎</div>
        <input placeholder="Message RedRob AI...">
        <div class="icon-btn">🎙️</div>
        <div class="send-btn">↑</div>
      </div>
      <div class="selectors">
        <div class="selector">🤖 RedRob Model 2 ▾</div>
        <div class="selector">🌐 English ▾</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="panel">
        <div class="panel-head">
          <h3>Featured AI tools</h3>
          <a href="#">Browse app store →</a>
        </div>
        <div class="tool-grid">
          <div class="tool-card"><span class="emo">🧠</span><b>Skill Tests</b><span>Benchmark yourself</span></div>
          <div class="tool-card"><span class="emo">📄</span><b>Resume Ranker</b><span>Score vs. the role</span></div>
          <div class="tool-card"><span class="emo">🗺️</span><b>Career Roadmap</b><span>Plan the next 2 yrs</span></div>
          <div class="tool-card"><span class="emo">🎤</span><b>Interview Prep</b><span>AI mock rounds</span></div>
          <div class="tool-card"><span class="emo">📊</span><b>Placement Tracker</b><span>All applications</span></div>
          <div class="tool-card"><span class="emo">🔬</span><b>Research Assistant</b><span>For your thesis</span></div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <h3>Internships for you</h3>
          <a href="#">See all →</a>
        </div>
        <div class="intern-list">
          <div class="intern-item">
            <div class="co-logo">DT</div>
            <div class="info"><b>Deloitte — Analyst Intern</b><span>Pune · Closes in 2 days</span></div>
            <div class="match">92% match</div>
          </div>
          <div class="intern-item">
            <div class="co-logo">RP</div>
            <div class="info"><b>Razorpay — SDE Intern</b><span>Bengaluru · Remote ok</span></div>
            <div class="match">88% match</div>
          </div>
          <div class="intern-item">
            <div class="co-logo">ZM</div>
            <div class="info"><b>Zomato — Product Intern</b><span>Gurugram</span></div>
            <div class="match">79% match</div>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>
</body>
</html>